---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import AppCard from '../components/AppCard.astro';
---
<Base
  title="Projects | Muhammad Babar"
  description="FINSTRIDE and two apps in development, designed and built independently under the ApexPaths name."
>
  <PageHeader
    title="Built after hours, run like products"
    lede="Designed, coded and shipped independently under the ApexPaths name. Each one answers a problem first met at work."
  />

  <section class="sec" aria-label="FINSTRIDE">
    <div class="wrap">
      <div class="feature">
        <div>
          <h2>FINSTRIDE</h2>
          <p class="status">Live</p>
          <p class="desc">Personal finance that stays honest: an income statement, balance sheet and cash flow, budgets, goals and cash-flow forecasts, on the web and as an installable phone app.</p>
          <a class="link" href="https://apexpaths.co" target="_blank" rel="noopener">Visit ApexPaths</a>
        </div>
        <div>
          <h3>What it took</h3>
          <ul>
            <li>PostgreSQL design for multi-user financial data, with separate books per user</li>
            <li>Security in depth: two-step login, passkeys, CSRF protection, a strict content security policy and rate limiting</li>
            <li>Offline entry on phones, and Paddle subscription billing with plan changes and automatic refunds</li>
          </ul>
          <p class="tools">Stack: Python, Flask, PostgreSQL, JavaScript, Render, Neon, Brevo</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec-flush" aria-labelledby="pipeline">
    <div class="wrap">
      <div class="sec-head"><h2 id="pipeline">Next in the pipeline</h2></div>
      <div class="app-grid">
        <AppCard name="DASHBOARDING APP" color="dash" status="In development">Several sheets in, one clear dashboard out. Drop in your spreadsheets and data files and get a dashboard in minutes. Every calculation runs in your browser, so your data never leaves your device.</AppCard>
        <AppCard name="REPORTING APP" color="report" status="In development">Claims reserving, reported your way. Reserving for actuarial teams, with reports shaped to each audience's needs. Works from summary data, so no policy-level detail is ever uploaded.</AppCard>
      </div>
    </div>
  </section>
</Base>
