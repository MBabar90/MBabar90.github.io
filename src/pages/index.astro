---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Ledger from '../components/Ledger.astro';
import WorkRows from '../components/WorkRows.astro';
import CareerBar from '../components/CareerBar.astro';
import MatchDiagram from '../components/MatchDiagram.astro';
import dp from '../assets/dp.jpg';

const linkedin = 'https://linkedin.com/in/mubabar90';
const credly = 'https://credly.com/users/muhammad-babar.8671adcf/badges';
const og = await getImage({ src: dp, width: 480, format: 'webp', quality: 70 });
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Muhammad Babar',
  jobTitle: 'Analytics Engineering and BI Lead',
  url: 'https://mbabar90.github.io',
  image: new URL(og.src, Astro.site).href,
  address: { '@type': 'PostalAddress', addressLocality: 'Lahore', addressCountry: 'PK' },
  sameAs: [linkedin, credly],
};
const proof = [
  { num: '1M+', what: 'workforce data points reconciled into one Employee 360 view', where: 'Engro, 2022 – 2026' },
  { num: '70%', what: 'less manual effort on group HR reporting', where: 'Engro, 2022 – 2026' },
  { num: '2,500+', what: 'employee certificates generated by Python automation', where: 'Engro, 2022 – 2026' },
  { num: '50%+', what: 'efficiency gain from automating actuarial reporting', where: 'SHMA, 2016 – 2017' },
];
const work = [
  { id: 'employee-360', title: 'One history for every employee', org: 'Engro, people analytics', result: '1M+ data points reconciled' },
  { id: 'hr-reporting', title: 'Group HR reporting, automated', org: 'Engro, people analytics', result: '70% less manual effort' },
  { id: 'uae-insurer', title: "Actuarial work for a major UAE insurer, as part of its external actuary's team", org: 'SHMA, actuarial', result: 'CBUAE requirements delivered' },
  { id: 'alteryx', title: 'From macros to Alteryx', org: 'SHMA, actuarial', result: '50%+ from the first VBA automation' },
];
---
<Base
  title="Muhammad Babar | Analytics Engineering and BI Lead"
  description="Analytics engineering and BI lead with nearly ten years across actuarial consulting and group-wide people analytics. Based in Lahore, open to remote roles."
  jsonLd={jsonLd}
>
  <section class="hero tex dark" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
      <div>
        <p class="role">Analytics Engineering and BI Lead, Lahore</p>
        <h1 id="hero-title">Many systems. Many IDs. One version of the truth.</h1>
        <p class="lede">Analytics engineering and BI leadership, built on nearly ten years of actuarial consulting and group-wide people analytics. Records traced across systems and subsidiaries, reconciled, then turned into reporting that runs itself.</p>
        <p class="avail">Open to remote roles: full-time, part-time or by engagement</p>
        <div class="ctas">
          <a class="btn btn-brass" href="/work">Read the case studies</a>
          <a class="btn btn-ghost" href="/projects">Explore the products</a>
        </div>
      </div>
      <figure class="diagram">
        <MatchDiagram />
        <figcaption>The Employee 360 problem: one person, three subsidiaries, three IDs, matched into a single history before it went into SAP SuccessFactors.</figcaption>
      </figure>
    </div>
  </section>

  <section class="sec" aria-labelledby="proof">
    <div class="wrap">
      <div class="sec-head"><h2 id="proof">Proof, in figures</h2></div>
      <Ledger rows={proof} />
    </div>
  </section>

  <section class="sec about" aria-labelledby="about">
    <div class="wrap about-grid">
      <div class="portrait">
        <Image src={dp} alt="Muhammad Babar" widths={[260, 340, 560]} sizes="(min-width: 900px) 340px, 260px" format="webp" quality={70} />
      </div>
      <div>
        <h2 id="about">Actuarial discipline, applied to enterprise data</h2>
        <p>Trained at <strong>SHMA</strong> in actuarial consulting: pricing, reserving and reinsurance analysis for insurers across the UAE, where every figure must survive an auditor. Repetitive reporting was automated as soon as it appeared.</p>
        <p>At <strong>Engro</strong>, one of Pakistan's largest groups, that rigour moved to people analytics: workforce data reconciled across subsidiaries, migrated into SAP SuccessFactors, and reported through Power BI and QlikSense across the group.</p>
        <p>The learning never stopped. <strong class="fin">FINSTRIDE</strong>, a personal finance app, was designed and shipped end to end in 2026: database, security, hosting and payments.</p>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="selected">
    <div class="wrap">
      <div class="sec-head"><h2 id="selected">Case studies</h2><a href="/work">All four case studies</a></div>
      <WorkRows rows={work} />
    </div>
  </section>

  <section class="sec sec-flush career" aria-labelledby="career">
    <div class="wrap">
      <div class="sec-head"><h2 id="career">Nearly ten years, one direction</h2><a href="/experience">Full experience and skills</a></div>
      <CareerBar />
    </div>
  </section>
</Base>
