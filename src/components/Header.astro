---
interface Props { active?: 'home' | 'experience' | 'work' }
const { active } = Astro.props;
const apps = active === 'home' ? '#apps' : '/#apps';
---
<header class="nav" id="nav"><div class="wrap">
  <a class="me" href="/">Muhammad Babar</a>
  <nav class="links" aria-label="Main">
    <a href="/experience/" class={active === 'experience' ? 'on' : undefined}>Experience</a><a href="/work/" class={active === 'work' ? 'on' : undefined}>Case studies</a><a href={apps}>Apps</a><a href="#contact">Contact</a>
    <a class="li-btn" href="https://www.linkedin.com/in/mubabar90" target="_blank" rel="noopener">LinkedIn</a>
  </nav>
</div></header>
